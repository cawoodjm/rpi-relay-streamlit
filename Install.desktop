[Desktop Entry]
Name=Install FlexRadio Relay Power Control
Comment=Install and Configure Relay Control
Exec=bash -c 'F="%k"; if [ "$F" = "%%k" ] || [ "$F" = "%k" ] || [ -z "$F" ]; then F="$1"; fi; F="${F#file://}"; if [ -z "$F" ] || [ ! -f "$F" ]; then F="./Install.desktop"; fi; if [ -f "$F" ]; then D="$(cd "$(dirname "$F")" && pwd)"; cd "$D"; fi; echo "Installation directory: $(pwd)"; if [ -f install.sh ]; then chmod +x install.sh && ./install.sh; else echo "Error: install.sh not found in $(pwd)"; fi; read -p "Press enter to close..." -n1 -s' -- %k
Path=
Icon=system-software-install
Terminal=true
Type=Application
Categories=Utility;
